# =============================================================================
# Entorno TEST — las apps siguen corriendo en local, pero los external-services
# son los de los servidores de test.
#
#   cp scripts/env/test.env.example scripts/env/test.env
#   # rellenar hosts y credenciales
#   ./scripts/start-all.sh --env test
#
# scripts/env/test.env está en .gitignore: NUNCA commitees credenciales reales.
#
# IMPORTANTE: deja los valores entre comillas simples. El fichero se carga con
# 'source', y caracteres como ; ! $ & se interpretarían como sintaxis del shell
# (el ';' de la URL JDBC de SQL Server la truncaría a la mitad).
#
# Modelo de migración: cada bloque se puede mover a test por separado. Lo que
# dejes comentado seguirá usando el default local del contenedor, así que puedes
# ir migrando servicio a servicio (p. ej. primero Kafka, luego las BD).
# =============================================================================

# --- Apps (siguen en local) --------------------------------------------------
CUSTOMER_SERVER_PORT='8081'
ARTICLE_SERVER_PORT='8082'

# --- Legacy en servidores de test --------------------------------------------
SQLSERVER_URL='jdbc:sqlserver://sqlserver-test.interno:1433;databaseName=poc;encrypt=true;trustServerCertificate=true'
SQLSERVER_USER=
SQLSERVER_PASSWORD=

POSTGRES_URL='jdbc:postgresql://postgres-test.interno:5432/poc'
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Almacenes en servidores de test -----------------------------------------
# Una base por dominio. Si el Mongo de test tiene auth:
#   mongodb://usuario:clave@host:27017/customer?authSource=admin
MONGO_URL_CUSTOMER='mongodb://mongo-test.interno:27017/customer'
MONGO_URL_ARTICLE='mongodb://mongo-test.interno:27017/article'
ES_URL='http://elastic-test.interno:9200'

# --- Mensajería en servidores de test ----------------------------------------
KAFKA_BOOTSTRAP='kafka-test.interno:9092'
KAFKA_CONNECT_URL='http://kafka-test.interno:8083'

# --- SAP ---------------------------------------------------------------------
# Opción A — seguir contra el WireMock local: deja MOCK_SAP_PORT y apunta las
# base-url a localhost (start-all.sh no levanta el mock en modo test, hazlo tú:
#   docker run --rm -d -p 8090:8080 --name mock-sap wiremock/wiremock:3.13.0
# Opción B — tenant SAP de test: rellena base-url y credenciales OAuth2.
SAP_BTP_BASE_URL=
SAP_BTP_TOKEN_URL=
SAP_BTP_CLIENT_ID=
SAP_BTP_CLIENT_SECRET=

SAP_S4_BASE_URL=
SAP_S4_AUTH_TYPE='oauth2'
SAP_S4_TOKEN_URL=
SAP_S4_CLIENT_ID=
SAP_S4_CLIENT_SECRET=

# CSRF: obligatorio para escrituras OData V2 contra un S/4 real.
SAP_S4_CSRF_ENABLED='true'

# --- Timeouts ----------------------------------------------------------------
# Contra servidores remotos conviene subirlos respecto a los defaults locales.
SAP_CLIENT_CONNECT_TIMEOUT_MS='5000'
SAP_CLIENT_RESPONSE_TIMEOUT_MS='30000'
