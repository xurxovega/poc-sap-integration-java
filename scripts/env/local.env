# =============================================================================
# Entorno LOCAL — todo en el equipo del desarrollador.
#
# Las URLs coinciden con los defaults de las apps y del compose de
# external-services. Las CREDENCIALES no: desde la Fase 4 del plan de auditoría
# el YAML empaquetado no trae usuario/clave de BD ni permite el token SAP stub
# por defecto, así que este fichero es OBLIGATORIO para arrancar en local
# (start-all.sh lo carga; a mano: `set -a; source scripts/env/local.env; set +a`).
#
# Lo carga ./scripts/start-all.sh (--env local, que es el valor por defecto).
# Los valores van entre comillas simples: el fichero se carga con 'source' y
# caracteres como ; ! $ se interpretarían como sintaxis del shell.
# =============================================================================

# --- Apps --------------------------------------------------------------------
CUSTOMER_SERVER_PORT='8081'
ARTICLE_SERVER_PORT='8082'

# --- Legacy (contenedores de external-services) ------------------------------
SQLSERVER_URL='jdbc:sqlserver://localhost:1433;databaseName=poc;encrypt=true;trustServerCertificate=true'
SQLSERVER_USER='sa'
SQLSERVER_PASSWORD='SqlServer_Pa55w0rd!'

POSTGRES_URL='jdbc:postgresql://localhost:5432/poc'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'

# --- Almacenes ---------------------------------------------------------------
# Una base por dominio: MONGO_URL sola serviria la misma a las dos apps.
MONGO_URL_CUSTOMER='mongodb://localhost:27017/customer'
MONGO_URL_ARTICLE='mongodb://localhost:27017/article'
ES_URL='http://localhost:9200'

# --- Mensajería --------------------------------------------------------------
KAFKA_BOOTSTRAP='localhost:9092'
KAFKA_CONNECT_URL='http://localhost:8083'

# --- SAP simulado (WireMock) -------------------------------------------------
# start-all.sh levanta el mock en este puerto y apunta ambos destinos SAP a él.
MOCK_SAP_PORT='8090'
SAP_BTP_BASE_URL='http://localhost:8090'
SAP_S4_BASE_URL='http://localhost:8090'

# Contra el mock no hay OAuth2: se autoriza EXPLICITAMENTE el token stub. Con
# false (el default de las apps) la app no arranca sin credenciales reales.
SAP_AUTH_ALLOW_STUB='true'

# --- Seguridad de las APIs ----------------------------------------------------
# En local no hay Keycloak: APIs abiertas (WARN al arrancar). En test/prod va a
# true con KEYCLOAK_ISSUER_URI, y cada endpoint exige su rol (sap-read, sap-write...).
APP_SECURITY_ENABLED='false'

# --- Ruta de salida a SAP ----------------------------------------------------
# Por defecto se usan los adaptadores BTP. Pon a true el que quieras enrutar por
# la API OData nativa de S/4 (conviven, se elige por configuración).
SAP_ODATA_ADDRESS_ENABLED='false'
SAP_ODATA_FISCAL_ENABLED='false'
SAP_ODATA_CONTACT_ENABLED='false'
SAP_ODATA_BANKING_ENABLED='false'
SAP_ODATA_CUSTOMER_ENABLED='false'
SAP_ODATA_READ_ENABLED='false'
