# =============================================================================
# Entorno PROD — desplegado en Kubernetes (ver deploy/README.md).
#
#   cp scripts/env/prod.env.example scripts/env/prod.env
#   # rellenar hosts y credenciales
#
# scripts/env/prod.env está en .gitignore: NUNCA commitees credenciales reales.
#
# IMPORTANTE: deja los valores entre comillas simples. El fichero se carga con
# 'source', y caracteres como ; ! $ & se interpretarían como sintaxis del shell
# (el ';' de la URL JDBC de SQL Server la truncaría a la mitad).
# =============================================================================

# --- Apps (puertos de los Services) ------------------------------------------
CUSTOMER_SERVER_PORT='8081'
ARTICLE_SERVER_PORT='8082'

# --- Legacy (URLs internas del cluster) --------------------------------------
SQLSERVER_URL='jdbc:sqlserver://sqlserver.data.svc:1433;databaseName=poc;encrypt=true;trustServerCertificate=true'
SQLSERVER_USER=
SQLSERVER_PASSWORD=

POSTGRES_URL='jdbc:postgresql://postgresql.data.svc:5432/poc'
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- SAP --------------------------------------------------------------------
SAP_S4_BASE_URL='https://<tenant>-api.s4hana.cloud.sap'
SAP_S4_AUTH_TYPE='oauth2'
SAP_S4_TOKEN_URL=
SAP_S4_CLIENT_ID=
SAP_S4_CLIENT_SECRET=

# CSRF: obligatorio para escrituras OData V2 contra un S/4 real.
SAP_S4_CSRF_ENABLED='true'

# --- Seguridad de las APIs (Keycloak) ---------------------------------------
# Obligatorio con APP_SECURITY_ENABLED=true: quien firma los tokens. Roles del
# realm o del cliente: sap-read, sap-write, sap-admin, sap-superadmin,
# sap-external-read (ver docs/tools-integrations/KEYCLOAK.md).
APP_SECURITY_ENABLED='true'
KEYCLOAK_ISSUER_URI='https://keycloak.interno/realms/<realm>'
KEYCLOAK_CLIENT_ID='sap-integration'

# --- Operación ---------------------------------------------------------------
# Tags comunes para Prometheus (OBS-005). OBS_CLUSTER es OBLIGATORIO en test y
# prod: si se deja vacio el tag cluster cae al default 'local' y las series se
# mezclan con las del equipo de desarrollo.
OBS_ENV='prod'
OBS_CLUSTER=    # obligatorio