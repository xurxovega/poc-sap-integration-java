<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.poc.sap</groupId>
        <artifactId>sap-integration-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sap-api-models</artifactId>
    <packaging>jar</packaging>
    <name>SAP Integration :: API Models</name>
    <description>Modelos Java generados desde specs OpenAPI oficiales de SAP (Business Partner, Product, Supplier)</description>

    <dependencies>
        <dependency>
            <groupId>com.sap.cloud.sdk.datamodel</groupId>
            <artifactId>openapi-core</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/openapi</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.sap.cloud.sdk.datamodel</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${sap-cloud-sdk.version}</version>
                <executions>
                    <execution>
                        <id>generate-customer-business-partner</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <!-- Spec canónica FUERA de src/main/resources para no empaquetarla en el JAR -->
                            <inputSpec>${project.basedir}/specs/customer/API_BUSINESS_PARTNER.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/openapi</outputDirectory>
                            <apiPackage>com.poc.sap.integration.api.customer.api</apiPackage>
                            <modelPackage>com.poc.sap.integration.api.customer.model</modelPackage>
                            <apiMaturity>released</apiMaturity>
                            <!-- Los adaptadores solo consumen los modelos; no generar clases de API client -->
                            <generateApis>false</generateApis>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
