{
  "title": "SAP resilience",
  "uid": "sap-resilience-v1",
  "tags": ["sap-integration", "sap", "resilience"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "time_options": ["5m", "15m", "1h", "6h", "24h"]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(sap_client_request_duration_seconds_count, env)",
        "label": "Environment",
        "refresh": 2
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(sap_client_request_duration_seconds_count{env=~\"$env\"}, cluster)",
        "label": "Cluster",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 duración HTTP SAP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, destination, method) (rate(sap_client_request_duration_seconds_bucket{destination=~\"btp|s4_native\", env=~\"$env\", cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "{{destination}}/{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Intentos por outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(sap_client_request_duration_seconds_count{destination=~\"btp|s4_native\", env=~\"$env\", cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Circuit breaker SAP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"sap\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "HALF-OPEN", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "OPEN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reintentos SAP",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (rate(resilience4j_retry_calls{name=\"sap\", env=~\"$env\", cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{kind}}/{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ]
}